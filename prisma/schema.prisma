generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  passwordHash          String
  name                  String?
  imageUrl              String?
  aiOptimizations       AiOptimization[]
  pdfHeaderText         String?
  pdfFooterText         String?
  pdfHeaderImageUrl     String?
  pdfFooterImageUrl     String?
  pdfLogoUrl            String?
  pdfHeaderTitle        String?
  pdfHeaderAddress      String?
  pdfHeaderTableJson    String?
  pdfHeaderLayout       String   @default("stacked")
  aiCreditsBalance      Int      @default(2000)
  billingPlan           String   @default("starter")
  deletedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  invoices              Invoice[]
  sendHistory           SendHistory[]
  accountants           Accountant[]
  structures            Structure[]
  aiUsageLogs           AiUsageLog[]
  billingEvents         BillingEvent[]
  ownedEnterprises      Enterprise[]       @relation("EnterpriseOwner")
  enterpriseMemberships EnterpriseMember[]
  submittedInvoices     Invoice[]          @relation("InvoiceSubmittedBy")
}

model Enterprise {
  id        String   @id @default(cuid())
  name      String
  siret     String?
  ownerId   String
  owner     User     @relation("EnterpriseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   EnterpriseMember[]
  @@index([ownerId])
  @@map("enterprises")
}

/// role: owner | manager | agent
/// status: pending | active | removed
model EnterpriseMember {
  id            String             @id @default(cuid())
  enterpriseId  String
  enterprise    Enterprise         @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String
  role          String             @default("agent")
  status        String             @default("pending")
  inviteToken   String?            @unique
  joinedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  @@unique([enterpriseId, email])
  @@index([enterpriseId])
  @@index([userId])
  @@map("enterprise_members")
}

model Structure {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  region    String
  type      String
  siret     String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("structures")
}

model LegalAlert {
  id          String   @id @default(cuid())
  title       String
  description String
  source      String
  url         String?
  pubDate     DateTime
  region      String   @default("france")
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("legal_alerts")
}

model Accountant {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region    String
  email     String
  label     String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@unique([userId, region, email])
  @@index([userId])
  @@map("accountants")
}

model Invoice {
  id                 String      @id @default(cuid())
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedByUserId  String?
  submittedBy        User?       @relation("InvoiceSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  filename        String
  originalName    String
  size            Int
  mimeType        String
  ocrText         String?
  region          String
  accountantId    String?
  accountant      Accountant? @relation(fields: [accountantId], references: [id], onDelete: SetNull)
  sentAt          DateTime?
  amount          Float?
  category        String?
  invoiceType     String      @default("achat")
  status          String      @default("pending")
  invoiceDate     DateTime?
  fileUrl         String?
  shareToken      String?     @unique
  fournisseur     String?
  numeroFacture   String?
  montantHT       Float?
  montantTVA      Float?
  tauxTVA         Float?
  montantTTC      Float?
  isPaid          Boolean?
  paidDate        DateTime?
  structureId     String?
  currency        String?   @default("EUR")
  accountCode     String?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  aiOptimizations   AiOptimization[]

  @@index([userId])
  @@index([submittedByUserId])
  @@map("invoices")
}

model AiOptimization {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  prompt    String
  response  String
  region    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("ai_optimizations")
}

model SendHistory {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region         String
  recipientEmail String
  message        String
  filesCount     Int
  sentAt         DateTime @default(now())
  success        Boolean  @default(true)
  error          String?

  @@index([userId])
  @@map("send_history")
}

model AiUsageLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  model          String
  promptChars    Int      @default(0)
  responseChars  Int      @default(0)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  estimatedCost  Float    @default(0)
  creditsDebited Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

model AdminAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String   @map("actor_user_id")
  actorEmail  String   @map("actor_email")
  actorRole   String   @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorUserId, createdAt])
  @@map("admin_audit_logs")
}

model BillingEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  credits    Int      @default(0)
  amountEur  Float?
  status     String   @default("succeeded")
  reference  String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("billing_events")
}

/// Plan comptable général (PCG) — comptes système partagés
model ChartAccount {
  id        String @id @default(cuid())
  num       String @unique
  label     String
  pcgClass  Int    @map("pcg_class")
  parentNum String? @map("parent_num")

  @@index([pcgClass])
  @@map("chart_accounts")
}

/// Écriture comptable (opération avec pièces jointes optionnelles)
model JournalEntry {
  id                String         @id @default(cuid())
  userId            String
  journalCode       String         @default("OD")
  journalLabel      String         @default("Opérations diverses")
  entryDate         DateTime
  pieceRef          String?
  label             String
  invoiceId         String?
  bankTransactionId String?        @unique
  attachmentUrl     String?
  attachmentName    String?
  mimeType          String?
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lines             JournalLine[]
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id           String       @id @default(cuid())
  entryId      String
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountNum   String
  accountLabel String
  debit        Float        @default(0)
  credit       Float        @default(0)

  @@index([entryId])
  @@index([accountNum])
  @@map("journal_lines")
}

model BankAccount {
  id           String            @id @default(cuid())
  userId       String
  name         String
  iban         String?
  bic          String?
  currency     String            @default("EUR")
  createdAt    DateTime          @default(now())
  transactions BankTransaction[]

  @@index([userId])
  @@map("bank_accounts")
}

model BankImportBatch {
  id           String            @id @default(cuid())
  userId       String
  format       String
  fileName     String
  rowCount     Int               @default(0)
  importedAt   DateTime          @default(now())
  transactions BankTransaction[]

  @@index([userId])
  @@map("bank_import_batches")
}

model BankTransaction {
  id               String           @id @default(cuid())
  userId           String
  bankAccountId    String?
  bankAccount      BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  importBatchId    String?
  importBatch      BankImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  transactionDate  DateTime
  label            String
  amount           Float
  reference        String?
  matchedInvoiceId String?
  rawData          String?
  createdAt        DateTime         @default(now())
  journalEntry     JournalEntry?

  @@index([userId, transactionDate])
  @@map("bank_transactions")
}
